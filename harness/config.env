# Non-secret defaults for the MaaS 3.5-GA-features harness (scenarios 17-20,
# see ../docs/scenarios/17-20). Assumes the base cluster + RHOAI 3.5 + MaaS
# gateway already exist -- built via openshift-aws-harness (base cluster)
# and monitoring-llmd-rhoai/harness (`./harness.sh maas`, RHCL/Kuadrant +
# modelsAsService). This harness only adds what's specific to testing the
# 3.5 MaaS Governance features. See ../AGENT.md for full cluster details.
#
# Override any of these by exporting the same name before invoking
# harness.sh, e.g.: BASTION_IP=1.2.3.4 ./harness.sh scenario17-keycloak-up

CLUSTER_NAME="${CLUSTER_NAME:-myocp}"
BASTION_IP="${BASTION_IP:-3.93.56.190}"
SSH_KEY_PATH="${SSH_KEY_PATH:-$HOME/.ssh/${CLUSTER_NAME}-bastion}"

# Scenario 17: Keycloak (RHBK operator) as the external OIDC IDP
KEYCLOAK_NAMESPACE="${KEYCLOAK_NAMESPACE:-maas-keycloak}"
KEYCLOAK_REALM="${KEYCLOAK_REALM:-maas-demo}"
KEYCLOAK_CLIENT_ID="${KEYCLOAK_CLIENT_ID:-maas-test-client}"
# Two groups mapped to two different MaaS subscription tiers, per the
# scenario 17 demo steps (basic vs premium quota).
KEYCLOAK_GROUP_BASIC="${KEYCLOAK_GROUP_BASIC:-maas-basic}"
KEYCLOAK_GROUP_PREMIUM="${KEYCLOAK_GROUP_PREMIUM:-maas-premium}"
KEYCLOAK_USER_BASIC="${KEYCLOAK_USER_BASIC:-basic-user}"
KEYCLOAK_USER_PREMIUM="${KEYCLOAK_USER_PREMIUM:-premium-user}"
# Generated (not committed) on first run and stored in
# harness/state/keycloak-users.env if left unset here.
KEYCLOAK_USER_PASSWORD="${KEYCLOAK_USER_PASSWORD:-}"

# Scenario 18: namespace/model used for the OpenAI-body-routing test.
# Point these at whatever LLMInferenceService(s) are already deployed
# (e.g. from monitoring-llmd-rhoai's scenario11-14 models, or a fresh one).
MAAS_TEST_NAMESPACE="${MAAS_TEST_NAMESPACE:-llmd-scenario11}"
MAAS_TEST_MODEL="${MAAS_TEST_MODEL:-}"

# Scenario 20: a non-admin htpasswd user, needed since create-admin-user
# only makes one admin account -- self-service Subscriptions is tested as
# an ordinary user.
SELF_SERVICE_USERNAME="${SELF_SERVICE_USERNAME:-maas-selfservice}"
SELF_SERVICE_PASSWORD="${SELF_SERVICE_PASSWORD:-}"
